#!/usr/bin/env bash
set -euo pipefail
shopt -s inherit_errexit

root=$(git rev-parse --show-toplevel)
cd "${root}"
python -B .github/lint/style_check.py
cargo fmt --all --check
timeout 1200 cargo clippy -p pageframe --all-targets --locked -- -D warnings
timeout 1200 cargo test -p pageframe --locked
timeout 600 pwsh -NoProfile -File .github/lint/Invoke-PSLint.ps1
timeout 600 pwsh -NoProfile -File .github/changelog/Test-UpdateChangelog.ps1
npx --no-install stylelint '**/*.{css,html}' --max-warnings 0
npx --no-install prettier --check .
if [[ ${OSTYPE} == msys* || ${OSTYPE} == cygwin* ]]; then
  windows_root=$(pwd -W)
  MSYS_NO_PATHCONV=1 timeout 180 wsl --distribution "${LINT_WSL_DISTRO:?Set LINT_WSL_DISTRO to your lint distro}" \
    --cd "${windows_root}" -- bash .githooks/check-shell
else
  bash .githooks/check-shell
fi
